{
  "entities": {
    "Correction": {
      "title": "Translation Correction",
      "description": "User-provided corrections for AI-generated translations.",
      "type": "object",
      "properties": {
        "sourceText": { "type": "string", "description": "Original Chinese text." },
        "aiTranslatedText": { "type": "string", "description": "Translation generated by AI." },
        "userCorrectedText": { "type": "string", "description": "Translation corrected by the user." },
        "section": { "type": "string", "enum": ["general", "briefing"], "description": "Which section this came from." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the correction was made." }
      },
      "required": ["sourceText", "aiTranslatedText", "userCorrectedText", "section", "createdAt"]
    },
    "LearnedPattern": {
      "title": "Learned Translation Pattern",
      "description": "Extracted terminology or phrasing patterns from user corrections.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["term", "phrase", "style"], "description": "The type of pattern discovered." },
        "source": { "type": "string", "description": "The original term or pattern in Chinese." },
        "target": { "type": "string", "description": "The preferred Korean translation." },
        "confidence": { "type": "number", "description": "Confidence score based on recurrence." },
        "count": { "type": "integer", "description": "How many times this pattern was observed." }
      },
      "required": ["type", "source", "target", "count"]
    }
  },
  "firestore": {
    "corrections": {
      "schema": "Correction",
      "description": "Logs of user corrections for Chinese translations."
    },
    "patterns": {
      "schema": "LearnedPattern",
      "description": "Extracted insights from Chinese corrections."
    },
    "corrections_en": {
      "schema": "Correction",
      "description": "Logs of user corrections for English translations."
    },
    "learned_patterns_en": {
      "schema": "LearnedPattern",
      "description": "Extracted insights from English corrections."
    },
    "corrections_ru": {
      "schema": "Correction",
      "description": "Logs of user corrections for Russian translations."
    },
    "learned_patterns_ru": {
      "schema": "LearnedPattern",
      "description": "Extracted insights from Russian corrections."
    }
  }
}
